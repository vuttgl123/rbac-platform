# Copy to .env and fill in. Never commit .env.
# Load with: set -a; source .env; set +a   (needed for the Flyway plugin; services read .env themselves)
# JDBC Session pooler URL; Flyway uses it as DB_USER, every service as its own role
DB_URL=
PSQL_URL=
DB_USER=
DB_PASSWORD=
PLATFORM_OPERATOR_EMAIL=
# Per-service database logins (through the Supabase pooler the user is <role>.<project-ref>)
IDENTITY_DB_USER=
IDENTITY_DB_PASSWORD=
AUTHZ_DB_USER=
AUTHZ_DB_PASSWORD=
AUDIT_DB_USER=
AUDIT_DB_PASSWORD=
# Passwords set by scripts/db/bootstrap_login_roles.sql (shared roles); the per-service ones by bootstrap_service_login_roles.sql
DB_APP_PASSWORD=
DB_ADMIN_PASSWORD=
