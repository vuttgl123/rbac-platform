# Copy to .env and fill in. Never commit .env.
# Load with: set -a; source .env; set +a
# JDBC Session pooler URL, used by Flyway (as DB_USER) and by the app (as DB_APP_USER, e.g. rbac_app.<project-ref>)
DB_URL=
PSQL_URL=
DB_USER=
DB_PASSWORD=
PLATFORM_OPERATOR_EMAIL=
DB_APP_USER=
DB_APP_PASSWORD=
DB_ADMIN_PASSWORD=
